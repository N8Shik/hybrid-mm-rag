__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
data/*.sqlite
data/*.db
reports/generated/


# Raw/full Olist source data and scratch notebooks: only the prebuilt
# data/olist.sqlite is needed at runtime (SQL engine) and Neo4j Aura is
# queried live, so the large raw CSVs don't need to ship with the app.
data/olist/*.csv
data/olist/*.ipynb
tmp/
DAY4_REPORT.md
design-qa.md
HEALTH_CHECK.md
PLAN.md

# Local Streamlit secrets (if you ever use `.streamlit/secrets.toml` instead
# of .env to test live mode) — holds real API keys, must never be committed.
# .streamlit/config.toml (theme, if you add one) is fine to keep tracked.
.streamlit/secrets.toml

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artifacts from `pip install -e .`
*.egg-info/
build/
dist/

# Jupyter checkpoint folders
**/.ipynb_checkpoints/
